% Flush pending figures and tables before starting the appendix.
% Keep standard article numbering: A, A.1, A.1.1.

\let\aes@originalappendix\appendix
\renewcommand{\appendix}{%
 \clearpage\aes@originalappendix
 \@addtoreset{figure}{section}%
