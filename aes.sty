% ===== cite-backlinks =====
% Load after natbib and hyperref (with backref=section).
\RequirePackage{etoolbox}

\newcounter{aes@citationtarget}
% Record a separate destination for each rendered citation, including repeated
% citations on one page. Keep each bibliography entry's display numbers local.
\renewcommand*\Hy@backout[1]{%
  \@bsphack
  \ifBR@enable
    \stepcounter{aes@citationtarget}%
    \ifcsundef{aes@count@#1}{\csgdef{aes@count@#1}{0}}{}%
    \csnumgdef{aes@count@#1}{\csuse{aes@count@#1}+1}%
    \edef\aes@target{aes.citation.\arabic{aes@citationtarget}}%
    \Hy@raisedlink{\hyper@anchorstart{\aes@target}\hyper@anchorend}%
    \protected@write\@auxout{}{%
      \string\@writefile{brf}{%
        \string\backcite{#1}{{\thepage}{\csuse{aes@count@#1}}{\aes@target}}%
      }%
    }%
  \fi
  \@esphack
}
\renewcommand*\backref[1]{}
\renewcommand*\backrefxxx[3]{%
  \begingroup\hypersetup{linkcolor=aeslink}%
  \hyperlink{#3}{#2}\endgroup
}
\renewcommand*\backrefalt[4]{%
  \ifnum#1>0\relax
    \space{\normalfont\fontsize{9}{11}\selectfont
      \textcolor{secondary}{Cited at: }#2.}%
  \fi
}
\renewcommand*\backrefsep{, }
\renewcommand*\backreftwosep{, }
\renewcommand*\backreflastsep{, }

% ===== authors =====
\RequirePackage{xparse,xcolor,hyperref}
\providecolor{bodyink}{HTML}{111318}
\providecolor{secondary}{HTML}{454754}
\providecommand{\regularfont}{\normalfont}
\ExplSyntaxOn
\seq_new:N \g_aes_authors_seq
\seq_new:N \g_aes_metadata_authors_seq
\NewExpandableDocumentCommand \aesmetaauthors {}
 {\seq_use:Nn \g_aes_metadata_authors_seq {;~}}
\seq_new:N \g_aes_affiliations_seq
\tl_new:N \g_aes_emails_tl
\tl_new:N \g_aes_equal_note_tl
\tl_new:N \g_aes_corresponding_note_tl
\tl_gset:Nn \g_aes_equal_note_tl {Equal~contribution.}
\tl_gset:Nn \g_aes_corresponding_note_tl {Corresponding~author.}
\bool_new:N \g_aes_has_equal_bool
\bool_new:N \g_aes_has_corresponding_bool
\tl_new:N \l_aes_affil_tl
\tl_new:N \l_aes_marks_tl
\bool_new:N \l_aes_equal_bool
\bool_new:N \l_aes_corresponding_bool
\keys_define:nn {aes/author}
 {
  affil .tl_set:N = \l_aes_affil_tl,
  equal .bool_set:N = \l_aes_equal_bool,
  equal .default:n = true,
  corresponding .bool_set:N = \l_aes_corresponding_bool,
  corresponding .default:n = true,
  corr .meta:n = {corresponding=#1},
  corr .default:n = true
 }
\cs_new_protected:Npn \aes_author_item:nn #1#2
 {\mbox{#1\tl_if_blank:nF {#2}{\textsuperscript{#2}}}}
\NewDocumentCommand \aesauthor {O{}m}
 {
  \seq_gput_right:Nn \g_aes_metadata_authors_seq {#2}
  \group_begin:
  \tl_clear:N \l_aes_affil_tl
  \bool_set_false:N \l_aes_equal_bool
  \bool_set_false:N \l_aes_corresponding_bool
  \keys_set:nn {aes/author}{#1}
  \tl_set_eq:NN \l_aes_marks_tl \l_aes_affil_tl
  \bool_if:NT \l_aes_equal_bool
   {
    \tl_if_empty:NF \l_aes_marks_tl {\tl_put_right:Nn \l_aes_marks_tl {,}}
    \tl_put_right:Nn \l_aes_marks_tl {\textdagger}
    \bool_gset_true:N \g_aes_has_equal_bool
   }
  \bool_if:NT \l_aes_corresponding_bool
   {
    \tl_if_empty:NF \l_aes_marks_tl {\tl_put_right:Nn \l_aes_marks_tl {,}}
    \tl_put_right:Nn \l_aes_marks_tl {*}
    \bool_gset_true:N \g_aes_has_corresponding_bool
   }
  \seq_gput_right:Nx \g_aes_authors_seq
   {\exp_not:N \aes_author_item:nn {\exp_not:n {#2}}{\exp_not:V \l_aes_marks_tl}}
  \group_end:
 }
\NewDocumentCommand \aesaffiliation {mm}
 {\seq_gput_right:Nn \g_aes_affiliations_seq {\textsuperscript{#1}\,#2}}
\NewDocumentCommand \aesemails {m}{\tl_gset:Nn \g_aes_emails_tl {#1}}
\NewDocumentCommand \aesemail {m}{\href{mailto:#1}{\nolinkurl{#1}}}
\NewDocumentCommand \aesequalnote {m}{\tl_gset:Nn \g_aes_equal_note_tl {#1}}
\NewDocumentCommand \aescorrespondingnote {m}{\tl_gset:Nn \g_aes_corresponding_note_tl {#1}}
\NewDocumentCommand \aesclearauthors {}
 {
  \seq_gclear:N \g_aes_authors_seq
  \seq_gclear:N \g_aes_metadata_authors_seq
  \seq_gclear:N \g_aes_affiliations_seq
  \tl_gclear:N \g_aes_emails_tl
  \bool_gset_false:N \g_aes_has_equal_bool
  \bool_gset_false:N \g_aes_has_corresponding_bool
 }
\NewDocumentCommand \aesmakeauthors {}
 {
  \par\noindent\begin{minipage}{\linewidth}
  \raggedright\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}
  {\regularfont\fontsize{10}{13}\selectfont\color{bodyink}
   \seq_use:Nn \g_aes_authors_seq {\penalty0\hskip1em\relax}\par}
  \seq_if_empty:NF \g_aes_affiliations_seq
   {\vspace{2pt}{\regularfont\fontsize{9}{12}\selectfont\color{secondary}
    \seq_use:Nn \g_aes_affiliations_seq {\penalty0\hskip1.5em\relax}\par}}
  \tl_if_blank:VF \g_aes_emails_tl
   {\vspace{2pt}{\regularfont\fontsize{9}{12}\selectfont\color{secondary}
    \tl_use:N \g_aes_emails_tl\par}}
  \bool_if:nT {\g_aes_has_equal_bool || \g_aes_has_corresponding_bool}
   {\vspace{3pt}{\regularfont\fontsize{8}{10.5}\selectfont\color{secondary}
    \bool_if:NT \g_aes_has_equal_bool
     {\textsuperscript{\textdagger}\,\tl_use:N \g_aes_equal_note_tl}
    \bool_if:nT {\g_aes_has_equal_bool && \g_aes_has_corresponding_bool}{\quad}
    \bool_if:NT \g_aes_has_corresponding_bool
     {\textsuperscript{*}\,\tl_use:N \g_aes_corresponding_note_tl}\par}}
  \end{minipage}\par
 }
\ExplSyntaxOff

