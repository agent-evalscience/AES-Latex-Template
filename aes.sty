% Keep numbered-heading destinations inside the heading's number box.
% A vertical anchor can otherwise remain on the preceding page when lineno
% moves the heading. Counter/label state and visual spacing are unchanged.
\newcommand{\aes@headingrefstepcounter}[1]{%
 \let\aes@savedraisedlink\Hy@raisedlink
 \let\Hy@raisedlink\@gobble
 \refstepcounter{#1}%
 \let\Hy@raisedlink\aes@savedraisedlink}
\patchcmd{\NR@sect}{\refstepcounter{#1}}{\aes@headingrefstepcounter{#1}}
 {}{\PackageError{aes}{Cannot defer heading destination}{}}
\patchcmd{\NR@sect}
 {\protected@edef\@svsec{\@seccntformat{#1}\relax}}
 {\protected@edef\@svsec{%
   \noexpand\Hy@raisedlink{%
    \noexpand\hyper@anchorstart{\@currentHref}\noexpand\hyper@anchorend}%
   \@seccntformat{#1}\relax}}
 {}{\PackageError{aes}{Cannot attach destination to heading}{}}

