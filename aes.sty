 \renewcommand{\thetable}{\thesection\arabic{table}}%
 % Distinct PDF destinations from the main text and other appendices.
 \def\theHfigure{appendix.\thesection.\arabic{figure}}%
 \def\theHtable{appendix.\thesection.\arabic{table}}%
}

