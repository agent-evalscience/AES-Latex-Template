% ===== lists =====
\RequirePackage{enumitem}
% Permit page breaks between items; discourage breaks within an item.
% Keep the first/last line with its neighbor; finite interior penalties
% let very long items split instead of overflowing a page.

\newcommand{\aeslistbreaks}{%
 \interlinepenalty=3000\relax
 \@clubpenalty=10000\relax
 \clubpenalty=10000\relax
 \widowpenalty=10000\relax}

% Accepted first-level bullet and numbered lists.
\setlist[itemize,1]{label=\textbullet,leftmargin=1.5em,labelsep=0.5em,
 itemsep=2pt,parsep=0pt,topsep=6pt,partopsep=0pt,
 midpenalty=0,before=\aeslistbreaks}
\setlist[enumerate,1]{label=\arabic*.,leftmargin=1.5em,labelsep=0.5em,
 itemsep=2pt,parsep=0pt,topsep=6pt,partopsep=0pt,
 midpenalty=0,before=\aeslistbreaks}

% ===== longtable =====
\RequirePackage{xparse,longtable,booktabs,caption,xcolor}
\providecolor{bodyink}{HTML}{111318}
\providecommand{\regularfont}{\normalfont}
% Arguments: column specification, column count, caption, label, header cells.
% The full caption is below the final fragment. Continuation pages repeat
% the table number and column headings without advancing the table counter.
\NewDocumentEnvironment{aeslongtable}{m m m m m}
 {%
  \par\begingroup
  \normalfont\fontsize{10}{13}\selectfont\color{bodyink}%
  \setlength{\parskip}{0pt}%
  \renewcommand{\arraystretch}{1.25}%
  \setlength{\LTleft}{0pt}%
  \setlength{\LTright}{0pt plus 1fill}%
  \setlength{\LTcapwidth}{\linewidth}%
  \setlength{\LTpre}{16pt}%
  \setlength{\LTpost}{16pt}%
  \captionsetup{position=bottom}%
  \begin{longtable}{#1}
  \toprule
  #5\\
  \midrule
  \endfirsthead
  \multicolumn{#2}{@{}l@{}}{%
   \regularfont\fontsize{10}{12}\selectfont\color{bodyink}%
   \tablename~\thetable\enspace\textbar\enspace Continued}\\[8pt]
  \toprule
  #5\\
  \midrule
  \endhead
  \bottomrule
  \endfoot
  \bottomrule
  \caption{#3}\label{#4}\\
  \endlastfoot
 }
 {\end{longtable}\endgroup}

